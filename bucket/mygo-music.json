{
    "version": "0.1.23",
    "description": "A native desktop music player with local playback and plugin support, built with Go and MyGo.",
    "homepage": "https://github.com/egoist/mygo-music",
    "license": "AGPL-3.0-only",
    "notes": [
        "To open mygo-music:// plugin links for the current Windows user, run:",
        "reg import \"$dir\\install-uri.reg\"",
        "This replaces any existing mygo-music protocol handler for that user, including when installed globally."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/egoist/mygo-music/releases/download/v0.1.23/mygo-music-0.1.23-windows-amd64.tar.gz",
            "hash": "7e3dc1c72b0b1796d197143e8148b9f454783e074edbf3eaf17c0393d19f6cda"
        },
        "arm64": {
            "url": "https://github.com/egoist/mygo-music/releases/download/v0.1.23/mygo-music-0.1.23-windows-arm64.tar.gz",
            "hash": "0600846c6bfd255d87763b7197e628124ad1d88813b19b6ced232f7579c3d404"
        }
    },
    "shortcuts": [
        [
            "MyGo Music.exe",
            "MyGo Music"
        ]
    ],
    "post_install": [
        "$exe = \"$dir\\MyGo Music.exe\".Replace('\\', '\\\\').Replace('\"', '\\\"')",
        "$registration = @(",
        "    'Windows Registry Editor Version 5.00',",
        "    '',",
        "    '[HKEY_CURRENT_USER\\Software\\Classes\\mygo-music]',",
        "    '@=\"URL:MyGo Music\"',",
        "    '\"URL Protocol\"=\"\"',",
        "    '',",
        "    '[HKEY_CURRENT_USER\\Software\\Classes\\mygo-music\\DefaultIcon]',",
        "    ('@=\"\\\"{0}\\\",0\"' -f $exe),",
        "    '',",
        "    '[HKEY_CURRENT_USER\\Software\\Classes\\mygo-music\\shell\\open\\command]',",
        "    ('@=\"\\\"{0}\\\" \\\"%1\\\"\"' -f $exe)",
        ")",
        "$registration | Set-Content -LiteralPath \"$dir\\install-uri.reg\" -Encoding Unicode",
        "$key = 'HKCU:\\Software\\Classes\\mygo-music'",
        "$command = Get-ItemPropertyValue -LiteralPath \"$key\\shell\\open\\command\" -Name '(default)' -ErrorAction SilentlyContinue",
        "$ownedCommand = '^\"' + [regex]::Escape((appdir $app $global)) + '\\\\[^\\\\]+\\\\MyGo Music\\.exe\" \"%1\"$'",
        "if ($command -and $command -match $ownedCommand) {",
        "    reg.exe import \"$dir\\install-uri.reg\"",
        "    if ($LASTEXITCODE -ne 0) { throw 'Failed to update the MyGo Music URI registration.' }",
        "}"
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    $key = 'HKCU:\\Software\\Classes\\mygo-music'",
            "    $command = Get-ItemPropertyValue -LiteralPath \"$key\\shell\\open\\command\" -Name '(default)' -ErrorAction SilentlyContinue",
            "    $ownedCommand = '^\"' + [regex]::Escape((appdir $app $global)) + '\\\\[^\\\\]+\\\\MyGo Music\\.exe\" \"%1\"$'",
            "    if ($command -and $command -match $ownedCommand) {",
            "        Remove-Item -LiteralPath $key -Recurse -ErrorAction Stop",
            "    }",
            "}"
        ]
    },
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/egoist/mygo-music/releases/download/v$version/mygo-music-$version-windows-amd64.tar.gz"
            },
            "arm64": {
                "url": "https://github.com/egoist/mygo-music/releases/download/v$version/mygo-music-$version-windows-arm64.tar.gz"
            }
        }
    }
}
